<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="740.0" prefWidth="1220.0" style="-fx-font-size: 13px; -fx-background-color: #f3f5f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectofinaljava2.controller.RecepcionistaController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1f3b57;">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Aparta-Suites UQ  |  Recepcion" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblFechaHora" style="-fx-text-fill: white;" text="Fecha del sistema" />
            <Label fx:id="lblBienvenida" style="-fx-text-fill: white;" text="Recepcionista" />
            <Button mnemonicParsing="false" onAction="#actualizarTodo" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cerrar sesion" />
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <!-- ===================== RESERVAS ===================== -->
            <Tab text="Reservas">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Todas las reservas" />
                              <TableView fx:id="tblReservas" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colCodigo" prefWidth="60.0" text="Codigo" />
                                    <TableColumn fx:id="colTitular" prefWidth="110.0" text="Titular" />
                                    <TableColumn fx:id="colApartamento" prefWidth="55.0" text="Apto" />
                                    <TableColumn fx:id="colEntrada" prefWidth="80.0" text="Entrada" />
                                    <TableColumn fx:id="colSalida" prefWidth="80.0" text="Salida" />
                                    <TableColumn fx:id="colCanal" prefWidth="70.0" text="Canal" />
                                    <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                                    <TableColumn fx:id="colValor" prefWidth="85.0" text="Valor" />
                                    <TableColumn fx:id="colSaldo" prefWidth="85.0" text="Saldo" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Ciclo de vida" />
                              <FlowPane hgap="8.0" vgap="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#confirmarReserva" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Confirmar" />
                                    <Button mnemonicParsing="false" onAction="#registrarLlegada" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Check-in" />
                                    <Button mnemonicParsing="false" onAction="#registrarSalida" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Check-out" />
                                    <Button mnemonicParsing="false" onAction="#declararNoShow" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Declarar no-show" />
                                    <Button mnemonicParsing="false" onAction="#cancelarReserva" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar reserva" />
                                 </children>
                              </FlowPane>
                              <Separator />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Folio: pagos y servicios adicionales" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtValorPago" prefWidth="130.0" promptText="Valor del pago" />
                                    <ComboBox fx:id="cbMedioPago" prefWidth="150.0" promptText="Medio de pago" />
                                    <Button mnemonicParsing="false" onAction="#registrarPago" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Registrar pago" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtDescripcionCargo" promptText="Servicio (desayuno, lavanderia...)" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtValorCargo" prefWidth="130.0" promptText="Valor" />
                                    <Button mnemonicParsing="false" onAction="#registrarCargo" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cargar servicio" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox prefWidth="500.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Detalle y folio" />
                              <TextArea fx:id="txtDetalle" editable="false" promptText="Seleccione una reserva" style="-fx-font-family: Consolas; -fx-font-size: 12px;" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== NUEVA RESERVA ===================== -->
            <Tab text="Nueva reserva">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox prefWidth="560.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Datos de la reserva" />
                              <GridPane hgap="10.0" vgap="8.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="130.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="Canal" />
                                    <ComboBox fx:id="cbCanal" maxWidth="Infinity" GridPane.columnIndex="1" />
                                    <Label text="Codigo externo" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtCodigoExterno" promptText="Ej: BK-12345" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Plataforma" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtPlataforma" promptText="Ej: Booking, Airbnb" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Documento titular" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtDocumentoTitular" promptText="Huesped registrado" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Apartamento" GridPane.rowIndex="4" />
                                    <ComboBox fx:id="cbApartamento" maxWidth="Infinity" promptText="Escoja un apartamento" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Entrada" GridPane.rowIndex="5" />
                                    <DatePicker fx:id="dpEntrada" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                    <Label text="Salida" GridPane.rowIndex="6" />
                                    <DatePicker fx:id="dpSalida" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                 </children>
                              </GridPane>
                              <Separator />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Ocupantes" />
                              <HBox spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtNombreOcupante" promptText="Nombre" HBox.hgrow="ALWAYS" />
                                    <DatePicker fx:id="dpNacimientoOcupante" prefWidth="140.0" promptText="Nacimiento" />
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#agregarOcupante" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregar" />
                                    <Button mnemonicParsing="false" onAction="#agregarTitularComoOcupante" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregar al titular" />
                                    <Button mnemonicParsing="false" onAction="#quitarOcupante" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Quitar" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblOcupantes" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colOcupNombre" prefWidth="250.0" text="Nombre" />
                                    <TableColumn fx:id="colOcupNacimiento" prefWidth="150.0" text="Nacimiento" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox spacing="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#cotizar" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cotizar" />
                                    <Button mnemonicParsing="false" onAction="#crearReserva" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Crear reserva" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Cotizacion noche por noche" />
                                    <TextArea fx:id="txtCotizacion" editable="false" style="-fx-font-family: Consolas; -fx-font-size: 12px;" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Conflictos de canal (reservas externas rechazadas)" />
                                    <TableView fx:id="tblConflictos" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colConfCodigo" prefWidth="80.0" text="Codigo" />
                                          <TableColumn fx:id="colConfPlataforma" prefWidth="80.0" text="Plataforma" />
                                          <TableColumn fx:id="colConfApartamento" prefWidth="50.0" text="Apto" />
                                          <TableColumn fx:id="colConfFechas" prefWidth="150.0" text="Fechas" />
                                          <TableColumn fx:id="colConfMotivo" prefWidth="200.0" text="Motivo" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== HUESPEDES ===================== -->
            <Tab text="Huespedes">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox prefWidth="420.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Registrar huesped" />
                              <GridPane hgap="10.0" vgap="8.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="120.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="Nombre" />
                                    <TextField fx:id="txtHuespNombre" GridPane.columnIndex="1" />
                                    <Label text="Documento" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtHuespDocumento" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Fecha nacimiento" GridPane.rowIndex="2" />
                                    <DatePicker fx:id="dpHuespNacimiento" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Telefono" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtHuespTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Correo" GridPane.rowIndex="4" />
                                    <TextField fx:id="txtHuespCorreo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Usuario" GridPane.rowIndex="5" />
                                    <TextField fx:id="txtHuespUsuario" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                    <Label text="Contrasena" GridPane.rowIndex="6" />
                                    <PasswordField fx:id="pfHuespContrasena" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                 </children>
                              </GridPane>
                              <Button mnemonicParsing="false" onAction="#registrarHuesped" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Registrar huesped" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Huespedes registrados (seleccione uno para usarlo como titular)" />
                              <TableView fx:id="tblHuespedes" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colHuespDocumento" prefWidth="110.0" text="Documento" />
                                    <TableColumn fx:id="colHuespNombre" prefWidth="160.0" text="Nombre" />
                                    <TableColumn fx:id="colHuespTelefono" prefWidth="110.0" text="Telefono" />
                                    <TableColumn fx:id="colHuespCorreo" prefWidth="180.0" text="Correo" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== APARTAMENTOS ===================== -->
            <Tab text="Apartamentos">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Estado operativo de los apartamentos" />
                              <TableView fx:id="tblApartamentos" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colAptoCodigo" prefWidth="60.0" text="Codigo" />
                                    <TableColumn fx:id="colAptoNombre" prefWidth="130.0" text="Nombre" />
                                    <TableColumn fx:id="colAptoCapacidad" prefWidth="75.0" text="Capacidad" />
                                    <TableColumn fx:id="colAptoEstado" prefWidth="160.0" text="Estado" />
                                    <TableColumn fx:id="colAptoMotivo" prefWidth="150.0" text="Motivo" />
                                    <TableColumn fx:id="colAptoNovedades" prefWidth="80.0" text="Novedades" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox prefWidth="420.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Cambiar estado" />
                              <ComboBox fx:id="cbEstado" maxWidth="Infinity" promptText="Nuevo estado" />
                              <TextField fx:id="txtMotivo" promptText="Motivo (obligatorio si queda fuera de servicio)" />
                              <Button mnemonicParsing="false" onAction="#cambiarEstadoApartamento" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Cambiar estado" />
                              <Separator />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Registrar novedad (dano, faltante...)" />
                              <TextField fx:id="txtNovedad" promptText="Descripcion de la novedad" />
                              <Button mnemonicParsing="false" onAction="#registrarNovedad" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Registrar novedad" />
                              <Label text="Novedades del apartamento seleccionado" />
                              <TextArea fx:id="txtNovedades" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
