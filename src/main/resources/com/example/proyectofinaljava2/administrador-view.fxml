<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="740.0" prefWidth="1220.0" style="-fx-font-size: 13px; -fx-background-color: #f3f5f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectofinaljava2.controller.AdministradorController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1f3b57;">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Aparta-Suites UQ  |  Administracion" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" style="-fx-text-fill: white;" text="Administrador" />
            <Button mnemonicParsing="false" onAction="#actualizarTodo" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cerrar sesion" />
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <!-- ===================== APARTAMENTOS ===================== -->
            <Tab text="Apartamentos">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Apartamentos (seleccione uno para editarlo)" />
                              <TableView fx:id="tblApartamentos" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colCodigo" prefWidth="55.0" text="Codigo" />
                                    <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                                    <TableColumn fx:id="colDormitorios" prefWidth="50.0" text="Dorm." />
                                    <TableColumn fx:id="colCapacidad" prefWidth="50.0" text="Cap." />
                                    <TableColumn fx:id="colBaja" prefWidth="85.0" text="T. Baja" />
                                    <TableColumn fx:id="colMedia" prefWidth="85.0" text="T. Media" />
                                    <TableColumn fx:id="colAlta" prefWidth="85.0" text="T. Alta" />
                                    <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                                    <TableColumn fx:id="colCaracteristicas" prefWidth="140.0" text="Caracteristicas" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox prefWidth="400.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Datos y tarifas por persona por noche" />
                              <GridPane hgap="10.0" vgap="7.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="120.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="Codigo" />
                                    <TextField fx:id="txtCodigo" GridPane.columnIndex="1" />
                                    <Label text="Nombre" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Dormitorios" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtDormitorios" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Capacidad maxima" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtCapacidad" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Caracteristicas" GridPane.rowIndex="4" />
                                    <TextField fx:id="txtCaracteristicas" promptText="Separadas por coma" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Tarifa baja" GridPane.rowIndex="5" />
                                    <TextField fx:id="txtTarifaBaja" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                    <Label text="Tarifa media" GridPane.rowIndex="6" />
                                    <TextField fx:id="txtTarifaMedia" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                    <Label text="Tarifa alta" GridPane.rowIndex="7" />
                                    <TextField fx:id="txtTarifaAlta" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                 </children>
                              </GridPane>
                              <FlowPane hgap="8.0" vgap="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#registrarApartamento" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Registrar" />
                                    <Button mnemonicParsing="false" onAction="#actualizarApartamento" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" />
                                    <Button mnemonicParsing="false" onAction="#eliminarApartamento" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Eliminar" />
                                    <Button mnemonicParsing="false" onAction="#limpiarApartamento" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar" />
                                 </children>
                              </FlowPane>
                              <Separator />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Bloquear fechas (mantenimiento, uso propio...)" />
                              <HBox spacing="8.0">
                                 <children>
                                    <DatePicker fx:id="dpBloqueoInicio" promptText="Desde" HBox.hgrow="ALWAYS" />
                                    <DatePicker fx:id="dpBloqueoFin" promptText="Hasta" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtBloqueoMotivo" promptText="Motivo" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#registrarBloqueo" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Bloquear" />
                                 </children>
                              </HBox>
                              <TextArea fx:id="txtBloqueos" editable="false" prefHeight="70.0" promptText="Bloqueos del apartamento" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== RECEPCIONISTAS ===================== -->
            <Tab text="Recepcionistas">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Recepcionistas (seleccione uno para editarlo)" />
                              <TableView fx:id="tblRecepcionistas" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colRecDocumento" prefWidth="90.0" text="Documento" />
                                    <TableColumn fx:id="colRecNombre" prefWidth="140.0" text="Nombre" />
                                    <TableColumn fx:id="colRecTelefono" prefWidth="100.0" text="Telefono" />
                                    <TableColumn fx:id="colRecCorreo" prefWidth="160.0" text="Correo" />
                                    <TableColumn fx:id="colRecUsuario" prefWidth="90.0" text="Usuario" />
                                    <TableColumn fx:id="colRecContratacion" prefWidth="95.0" text="Contratacion" />
                                    <TableColumn fx:id="colRecActivo" prefWidth="95.0" text="Estado" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox prefWidth="380.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Datos del recepcionista" />
                              <GridPane hgap="10.0" vgap="8.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="100.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="Nombre" />
                                    <TextField fx:id="txtRecNombre" GridPane.columnIndex="1" />
                                    <Label text="Documento" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtRecDocumento" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Telefono" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtRecTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Correo" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtRecCorreo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Usuario" GridPane.rowIndex="4" />
                                    <TextField fx:id="txtRecUsuario" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Contrasena" GridPane.rowIndex="5" />
                                    <PasswordField fx:id="pfRecContrasena" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                 </children>
                              </GridPane>
                              <FlowPane hgap="8.0" vgap="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#contratarRecepcionista" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Contratar" />
                                    <Button mnemonicParsing="false" onAction="#actualizarRecepcionista" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" />
                                    <Button mnemonicParsing="false" onAction="#desvincularRecepcionista" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Desvincular" />
                                    <Button mnemonicParsing="false" onAction="#limpiarRecepcionista" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar" />
                                 </children>
                              </FlowPane>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== TEMPORADAS Y POLITICA ===================== -->
            <Tab text="Temporadas y politica">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox prefWidth="480.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Periodos de temporada (lo demas es BAJA)" />
                              <TableView fx:id="tblTemporadas" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colTempTipo" prefWidth="100.0" text="Temporada" />
                                    <TableColumn fx:id="colTempInicio" prefWidth="140.0" text="Desde" />
                                    <TableColumn fx:id="colTempFin" prefWidth="140.0" text="Hasta" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox spacing="8.0">
                                 <children>
                                    <ComboBox fx:id="cbTipoTemporada" prefWidth="110.0" promptText="Tipo" />
                                    <DatePicker fx:id="dpTempInicio" promptText="Desde" HBox.hgrow="ALWAYS" />
                                    <DatePicker fx:id="dpTempFin" promptText="Hasta" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#agregarTemporada" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregar periodo" />
                                    <Button mnemonicParsing="false" onAction="#eliminarTemporada" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Eliminar seleccionado" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Politica de cancelacion" />
                                    <Label fx:id="lblPoliticaActual" style="-fx-text-fill: #6b7785;" text="Actual" wrapText="true" />
                                    <GridPane hgap="10.0" vgap="8.0">
                                       <columnConstraints>
                                          <ColumnConstraints minWidth="260.0" />
                                          <ColumnConstraints hgrow="ALWAYS" />
                                       </columnConstraints>
                                       <children>
                                          <Label text="Dias para devolver todo (mas de)" />
                                          <TextField fx:id="txtDiasDevolucion" GridPane.columnIndex="1" />
                                          <Label text="Horas minimas para retencion parcial" GridPane.rowIndex="1" />
                                          <TextField fx:id="txtHorasRetencion" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label text="Porcentaje de retencion parcial" GridPane.rowIndex="2" />
                                          <TextField fx:id="txtPorcentajeRetencion" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                       </children>
                                    </GridPane>
                                    <Button mnemonicParsing="false" onAction="#guardarPolitica" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar politica" />
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Reloj del sistema (para demostraciones)" />
                                    <Label fx:id="lblReloj" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2e6da4;" text="Fecha y hora" />
                                    <Label style="-fx-text-fill: #6b7785;" text="Sirve para mostrar el vencimiento de 24 horas y el no-show de las 10:00 p. m." wrapText="true" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#adelantarUnaHora" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="+1 hora" />
                                          <Button mnemonicParsing="false" onAction="#adelantarUnDia" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="+1 dia" />
                                          <Button mnemonicParsing="false" onAction="#volverHoraReal" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Hora real" />
                                       </children>
                                    </HBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== REPORTES ===================== -->
            <Tab text="Reportes">
               <content>
                  <VBox spacing="12.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Periodo" />
                              <DatePicker fx:id="dpRepInicio" prefWidth="140.0" promptText="Desde" />
                              <DatePicker fx:id="dpRepFin" prefWidth="140.0" promptText="Hasta" />
                              <Button mnemonicParsing="false" onAction="#generarReportes" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Generar reportes" />
                              <Region HBox.hgrow="ALWAYS" />
                              <VBox spacing="2.0">
                                 <children>
                                    <Label fx:id="lblIngresos" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2e6da4;" text="Ingresos" />
                                    <Label fx:id="lblComisiones" text="Comisiones" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                           </padding>
                        </HBox>
                        <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Ocupacion por apartamento" />
                                    <TableView fx:id="tblOcupacion" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colOcupApartamento" prefWidth="170.0" text="Apartamento" />
                                          <TableColumn fx:id="colOcupNoches" prefWidth="100.0" text="Noches ocupadas" />
                                          <TableColumn fx:id="colOcupPorcentaje" prefWidth="90.0" text="Ocupacion" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Reservas con saldo pendiente" />
                                    <TableView fx:id="tblSaldos" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colSalCodigo" prefWidth="70.0" text="Reserva" />
                                          <TableColumn fx:id="colSalTitular" prefWidth="130.0" text="Titular" />
                                          <TableColumn fx:id="colSalEstado" prefWidth="90.0" text="Estado" />
                                          <TableColumn fx:id="colSalSaldo" prefWidth="100.0" text="Saldo" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Apartamentos con mas novedades" />
                                    <TableView fx:id="tblNovedades" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colNovApartamento" prefWidth="170.0" text="Apartamento" />
                                          <TableColumn fx:id="colNovCantidad" prefWidth="90.0" text="Novedades" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox prefHeight="170.0" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Reservas por canal (incluye canceladas y no-show)" />
                              <TableView fx:id="tblCanales" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colCanal" prefWidth="90.0" text="Canal" />
                                    <TableColumn fx:id="colCanTotal" prefWidth="70.0" text="Total" />
                                    <TableColumn fx:id="colCanPendiente" prefWidth="80.0" text="Pendiente" />
                                    <TableColumn fx:id="colCanConfirmada" prefWidth="85.0" text="Confirmada" />
                                    <TableColumn fx:id="colCanEnCurso" prefWidth="80.0" text="En curso" />
                                    <TableColumn fx:id="colCanFinalizada" prefWidth="85.0" text="Finalizada" />
