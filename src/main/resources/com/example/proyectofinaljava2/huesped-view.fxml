<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" style="-fx-font-size: 13px; -fx-background-color: #f3f5f8;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectofinaljava2.controller.HuespedController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1f3b57;">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Aparta-Suites UQ  |  Portal del huesped" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" style="-fx-text-fill: white;" text="Hola" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cerrar sesion" />
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <!-- ===================== BUSCAR Y RESERVAR ===================== -->
            <Tab text="Buscar y reservar">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="1. Fechas y numero de personas" />
                                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                       <children>
                                          <VBox spacing="4.0">
                                             <children>
                                                <Label text="Entrada" />
                                                <DatePicker fx:id="dpEntrada" prefWidth="150.0" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="4.0">
                                             <children>
                                                <Label text="Salida" />
                                                <DatePicker fx:id="dpSalida" prefWidth="150.0" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="4.0">
                                             <children>
                                                <Label text="Personas" />
                                                <Spinner fx:id="spPersonas" editable="true" initialValue="1" max="20" min="1" prefWidth="80.0" />
                                             </children>
                                          </VBox>
                                          <Button mnemonicParsing="false" onAction="#buscarDisponibles" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Buscar" />
                                       </children>
                                    </HBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="2. Apartamentos disponibles (seleccione uno)" />
                                    <TableView fx:id="tblDisponibles" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colDispCodigo" prefWidth="60.0" text="Codigo" />
                                          <TableColumn fx:id="colDispNombre" prefWidth="130.0" text="Nombre" />
                                          <TableColumn fx:id="colDispDormitorios" prefWidth="85.0" text="Dormitorios" />
                                          <TableColumn fx:id="colDispCapacidad" prefWidth="80.0" text="Capacidad" />
                                          <TableColumn fx:id="colDispCaracteristicas" prefWidth="180.0" text="Caracteristicas" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox prefWidth="470.0" spacing="12.0">
                           <children>
                              <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="3. Ocupantes (todas las personas que se alojan)" />
                                    <HBox alignment="BOTTOM_LEFT" spacing="8.0">
                                       <children>
                                          <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label text="Nombre" />
                                                <TextField fx:id="txtNombreOcupante" promptText="Nombre del ocupante" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="4.0">
                                             <children>
                                                <Label text="Fecha nacimiento" />
                                                <DatePicker fx:id="dpNacimientoOcupante" prefWidth="140.0" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#agregarOcupante" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregar" />
                                          <Button mnemonicParsing="false" onAction="#agregarmeComoOcupante" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregarme a mi" />
                                          <Button mnemonicParsing="false" onAction="#quitarOcupante" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Quitar" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tblOcupantes" prefHeight="130.0">
                                       <columns>
                                          <TableColumn fx:id="colOcupNombre" prefWidth="250.0" text="Nombre" />
                                          <TableColumn fx:id="colOcupNacimiento" prefWidth="150.0" text="Nacimiento" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                              <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="4. Cotizar y reservar" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#cotizar" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cotizar" />
                                          <Button mnemonicParsing="false" onAction="#reservar" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Reservar" />
                                       </children>
                                    </HBox>
                                    <TextArea fx:id="txtCotizacion" editable="false" promptText="Aqui aparece el valor noche por noche" style="-fx-font-family: Consolas; -fx-font-size: 12px;" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== MIS RESERVAS ===================== -->
            <Tab text="Mis reservas">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Mis reservas" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#actualizarMisReservas" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblMisReservas" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colResCodigo" prefWidth="70.0" text="Codigo" />
                                    <TableColumn fx:id="colResApartamento" prefWidth="120.0" text="Apartamento" />
                                    <TableColumn fx:id="colResEntrada" prefWidth="85.0" text="Entrada" />
                                    <TableColumn fx:id="colResSalida" prefWidth="85.0" text="Salida" />
                                    <TableColumn fx:id="colResEstado" prefWidth="95.0" text="Estado" />
                                    <TableColumn fx:id="colResValor" prefWidth="95.0" text="Valor" />
                                    <TableColumn fx:id="colResSaldo" prefWidth="95.0" text="Saldo" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Pagar anticipo o abono" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtValorPago" prefWidth="140.0" promptText="Valor en pesos" />
                                    <ComboBox fx:id="cbMedioPago" prefWidth="150.0" promptText="Medio de pago" />
                                    <Button mnemonicParsing="false" onAction="#pagar" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Pagar" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#cancelarReserva" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar reserva" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        <VBox prefWidth="520.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Detalle y folio de la reserva" />
                              <TextArea fx:id="txtFolio" editable="false" promptText="Seleccione una reserva para ver su detalle" style="-fx-font-family: Consolas; -fx-font-size: 12px;" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
            <!-- ===================== MI PERFIL ===================== -->
            <Tab text="Mi perfil">
               <content>
                  <HBox spacing="15.0">
                     <children>
                        <VBox prefWidth="480.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde3ea; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Datos personales" />
                              <GridPane hgap="10.0" vgap="8.0">
                                 <columnConstraints>
                                    <ColumnConstraints minWidth="130.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="Nombre" />
                                    <TextField fx:id="txtPerfilNombre" GridPane.columnIndex="1" />
                                    <Label text="Documento" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtPerfilDocumento" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Fecha nacimiento" GridPane.rowIndex="2" />
                                    <DatePicker fx:id="dpPerfilNacimiento" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Telefono" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtPerfilTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Correo" GridPane.rowIndex="4" />
                                    <TextField fx:id="txtPerfilCorreo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Usuario" GridPane.rowIndex="5" />
                                    <TextField fx:id="txtPerfilUsuario" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                 </children>
                              </GridPane>
                              <Button mnemonicParsing="false" onAction="#guardarPerfil" style="-fx-background-color: #2e6da4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar cambios" />
                              <Separator />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" text="Cambiar contrasena" />
                              <HBox spacing="8.0">
                                 <children>
                                    <PasswordField fx:id="pfNuevaContrasena" promptText="Nueva contrasena" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#cambiarContrasena" style="-fx-background-color: #e4eaf1; -fx-text-fill: #1f3b57; -fx-background-radius: 6; -fx-cursor: hand;" text="Cambiar" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
